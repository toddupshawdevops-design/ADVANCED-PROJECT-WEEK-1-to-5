    /*
     * ========================================================
     * CONSTRUCTOR
     * ========================================================
     */

    public Server(
            String assetId,
            String description,
            String assignedTo,
            String environment) {

        super(
                assetId,
                description,
                assignedTo
        );

        this.environment =
                environment;
    }


    /*
     * ========================================================
     * GETTER
     * ========================================================
     */

    public String getEnvironment() {

        return environment;
    }


    /*
     * ========================================================
     * ABSTRACT METHOD IMPLEMENTATION
     * ========================================================
     */

    @Override
    public String getAssetType() {

        return "Server";
    }


    /*
     * ========================================================
     * INTERFACE IMPLEMENTATION
     * ========================================================
     */

    @Override
    public String generateReport() {

        return "Server Report: "
                + getBasicAssetInformation()
                + " | Environment: "
                + environment;
    }


    /*
     * ========================================================
     * POLYMORPHISM
     * ========================================================
     */

    @Override
    public String displayInfo() {

        return String.format(
                "%-10s %-12s %-25s %-20s Environment: %s",
                getAssetId(),
                getAssetType(),
                getDescription(),
                getAssignedTo(),
                environment
        );
    }
}


/*
 * ============================================================
 * ASSET INVENTORY CLASS
 * ============================================================
 *
 * COMPOSITION:
 *
 * AssetInventory contains a List of Asset objects.
 *
 * Because Asset is abstract, the list can contain any concrete
 * subclass such as Laptop or Server.
 */
class AssetInventory {


    /*
     * PRIVATE:
     *
     * The collection is kept private to protect the inventory's
     * internal data.
     */
    private final List<Asset> assets;


    /*
     * ========================================================
     * CONSTRUCTOR
     * ========================================================
     */

    public AssetInventory() {

        assets =
                new ArrayList<>();
    }


    /*
     * ========================================================
     * ADD ASSET
     * ========================================================
     */

    public void addAsset(Asset asset) {

        assets.add(asset);
    }


    /*
     * ========================================================
     * DISPLAY ALL ASSETS
     * ========================================================
     *
     * POLYMORPHISM:
     *
     * Asset is an abstract base-class reference.
     *
     * The actual objects are Laptop and Server.
     *
     * Java determines which displayInfo() implementation
     * should execute at runtime.
     */

    public void displayAllAssets() {

        System.out.println();

        System.out.println(
                "=============================================================="
        );

        System.out.println(
                "                    IT ASSET INVENTORY"
        );

        System.out.println(
                "=============================================================="
        );


        System.out.printf(
                "%-10s %-12s %-25s %-20s%n",
                "ID",
                "TYPE",
                "DESCRIPTION",
                "ASSIGNED TO"
        );


        System.out.println(
                "--------------------------------------------------------------"
        );


        for (Asset asset : assets) {

            System.out.println(
                    asset.displayInfo()
            );
        }


        System.out.println(
                "=============================================================="
        );
    }


    /*
     * ========================================================
     * GENERATE REPORTS
     * ========================================================
     *
     * POLYMORPHISM + INTERFACE:
     *
     * Each Asset is also a Reportable object because the
     * concrete child classes implement the interface.
     */

    public void generateAllReports() {

        System.out.println();

        System.out.println(
                "-------------------- ASSET REPORTS -------------------------"
        );

        System.out.println();


        for (Asset asset : assets) {

            Asset.Reportable report =
                    (Asset.Reportable) asset;


            System.out.println(
                    report.generateReport()
            );
        }


        System.out.println();
    }


    /*
     * ========================================================
     * POLYMORPHISM DEMONSTRATION
     * ========================================================
     */

    public void demonstratePolymorphism() {

        System.out.println();

        System.out.println(
                "------------------- POLYMORPHISM ---------------------------"
        );

        System.out.println();


        for (Asset asset : assets) {

            System.out.println(
                    "Reference Type: Asset"
            );

            System.out.println(
                    "Actual Object: "
                    + asset.getClass().getSimpleName()
            );

            System.out.println(
                    "Asset Type: "
                    + asset.getAssetType()
            );


            Asset.Reportable report =
                    (Asset.Reportable) asset;


            System.out.println(
                    "Generated Report:"
            );

            System.out.println(
                    report.generateReport()
            );

            System.out.println(
                    "--------------------------------------------------------------"
            );
        }


        System.out.println();

        System.out.println(
                "POLYMORPHISM SUCCESSFULLY DEMONSTRATED."
        );
    }
}
