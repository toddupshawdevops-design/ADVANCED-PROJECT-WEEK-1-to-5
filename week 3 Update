/*
 * ============================================================
 * LAPTOP CLASS
 * ============================================================
 *
 * INHERITANCE:
 *
 * Laptop inherits from the abstract Asset class.
 *
 * INTERFACE:
 *
 * Laptop implements Reportable.
 */
class Laptop
        extends Asset
        implements Asset.Reportable {


    /*
     * PRIVATE:
     *
     * Operating system is internal Laptop data.
     */
    private String operatingSystem;


    /*
     * ========================================================
     * CONSTRUCTOR #1
     * ========================================================
     *
     * Parameterized constructor.
     */

    public Laptop(
            String assetId,
            String description,
            String assignedTo,
            String operatingSystem) {

        super(
                assetId,
                description,
                assignedTo
        );

        this.operatingSystem =
                operatingSystem;
    }


    /*
     * ========================================================
     * CONSTRUCTOR #2
     * ========================================================
     *
     * Overloaded constructor.
     *
     * This demonstrates constructor overloading.
     */

    public Laptop(
            String assetId,
            String description) {

        super(
                assetId,
                description
        );

        this.operatingSystem =
                "Not Specified";
    }


    /*
     * ========================================================
     * GETTER
     * ========================================================
     */

    public String getOperatingSystem() {

        return operatingSystem;
    }


    /*
     * ========================================================
     * ABSTRACT METHOD IMPLEMENTATION
     * ========================================================
     *
     * The abstract Asset method requires each child class
     * to identify its own asset type.
     */

    @Override
    public String getAssetType() {

        return "Laptop";
    }


    /*
     * ========================================================
     * INTERFACE IMPLEMENTATION
     * ========================================================
     *
     * Laptop implements generateReport() from Reportable.
     */

    @Override
    public String generateReport() {

        return "Laptop Report: "
                + getBasicAssetInformation()
                + " | OS: "
                + operatingSystem;
    }


    /*
     * ========================================================
     * POLYMORPHISM
     * ========================================================
     *
     * Laptop provides its own displayInfo() implementation.
     */

    @Override
    public String displayInfo() {

        return String.format(
                "%-10s %-12s %-25s %-20s OS: %s",
                getAssetId(),
                getAssetType(),
                getDescription(),
                getAssignedTo(),
                operatingSystem
        );
    }
}


/*
 * ============================================================
 * SERVER CLASS
 * ============================================================
 *
 * INHERITANCE:
 *
 * Server inherits from the abstract Asset class.
 *
 * INTERFACE:
 *
 * Server implements Reportable.
 */
