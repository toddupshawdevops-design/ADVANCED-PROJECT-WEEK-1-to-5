/*
 * ============================================================
 * ABSTRACT BASE CLASS
 * ============================================================
 *
 * ABSTRACTION:
 *
 * Asset is abstract because a generic "Asset" does not need
 * to be instantiated directly. Instead, specific asset types
 * such as Laptop and Server inherit from Asset.
 *
 * The abstract methods require child classes to provide their
 * own implementations.
 */
public abstract class Asset {

    /*
     * ACCESS SPECIFIER:
     *
     * Private data can only be directly accessed inside Asset.
     * This protects the object's internal data.
     */
    private String assetId;

    private String description;

    private String assignedTo;


    /*
     * ========================================================
     * INTERFACE FROM WEEK 2
     * ========================================================
     *
     * The interface provides a common reporting contract.
     */
    public interface Reportable {

        String generateReport();
    }


    /*
     * ========================================================
     * CONSTRUCTOR #1
     * ========================================================
     *
     * Default constructor.
     *
     * This demonstrates a no-argument constructor.
     */
    public Asset() {

        this.assetId = "UNASSIGNED";

        this.description = "Unknown Asset";

        this.assignedTo = "Unassigned";
    }


    /*
     * ========================================================
     * CONSTRUCTOR #2
     * ========================================================
     *
     * Parameterized constructor.
     *
     * This constructor allows the caller to provide realistic
     * asset information when creating an object.
     */
    public Asset(
            String assetId,
            String description,
            String assignedTo) {

        this.assetId = assetId;

        this.description = description;

        this.assignedTo = assignedTo;
    }


    /*
     * ========================================================
     * CONSTRUCTOR #3
     * ========================================================
     *
     * Overloaded constructor.
     *
     * This demonstrates constructor overloading.
     */
    public Asset(
            String assetId,
            String description) {

        this.assetId = assetId;

        this.description = description;

        this.assignedTo = "Unassigned";
    }


    /*
     * ========================================================
     * ACCESSORS
     * ========================================================
     *
     * The fields remain private.
     *
     * Public getter methods provide controlled access to the
     * information outside the class.
     */

    public String getAssetId() {

        return assetId;
    }


    public String getDescription() {

        return description;
    }


    public String getAssignedTo() {

        return assignedTo;
    }


    /*
     * ========================================================
     * MUTATOR
     * ========================================================
     *
     * Public because other parts of the application need to
     * update the assigned employee/team.
     */

    public void setAssignedTo(String assignedTo) {

        this.assignedTo = assignedTo;
    }


    /*
     * ========================================================
     * PROTECTED METHOD
     * ========================================================
     *
     * Protected allows the base class and child classes to
     * access this functionality.
     *
     * This is an example of appropriate use of protected
     * access.
     */
    protected String getBasicAssetInformation() {

        return assetId
                + " | "
                + description
                + " | Assigned to: "
                + assignedTo;
    }


    /*
     * ========================================================
     * ABSTRACT METHOD #1
     * ========================================================
     *
     * ABSTRACTION:
     *
     * Every child asset must identify its asset type.
     *
     * Asset does not define the exact answer.
     *
     * Laptop and Server provide the implementation.
     */
    public abstract String getAssetType();


    /*
     * ========================================================
     * ABSTRACT METHOD #2
     * ========================================================
     *
     * ABSTRACTION:
     *
     * Every reportable asset must generate a report.
     *
     * The child classes determine what their reports contain.
     */
    public abstract String generateReport();


    /*
     * ========================================================
     * DISPLAY METHOD
     * ========================================================
     *
     * This method provides common behavior for all assets.
     */
    public String displayInfo() {

        return String.format(
                "%-10s %-12s %-25s %-20s",
                assetId,
                getAssetType(),
                description,
                assignedTo
        );
    }


