/*
 * ============================================================
 * LAPTOP CLASS
 * ============================================================
 *
 * INHERITANCE:
 *
 * Laptop extends Asset.
 *
 * INTERFACE:
 *
 * Laptop implements Asset.Reportable.
 */
class Laptop extends Asset
        implements Asset.Reportable {

    private String operatingSystem;


    /*
     * Constructor.
     */

    public Laptop(
            String assetId,
            String description,
            String assignedTo,
            String operatingSystem) {

        super(
                assetId,
                description,
                assignedTo
        );

        this.operatingSystem =
                operatingSystem;
    }


    /*
     * Override asset type.
     */

    @Override
    public String getAssetType() {

        return "Laptop";
    }


    /*
     * INTERFACE IMPLEMENTATION:
     *
     * Laptop implements the generateReport() method
     * defined by Reportable.
     */
    @Override
    public String generateReport() {

        return "Laptop Report: "
                + getAssetId()
                + " | "
                + getDescription()
                + " | Assigned to: "
                + getAssignedTo()
                + " | OS: "
                + operatingSystem;
    }


    /*
     * POLYMORPHISM:
     *
     * Laptop overrides displayInfo().
     */
    @Override
    public String displayInfo() {

        return String.format(
                "%-10s %-12s %-25s %-20s OS: %s",
                getAssetId(),
                getAssetType(),
                getDescription(),
                getAssignedTo(),
                operatingSystem
        );
    }
}


/*
 * ============================================================
 * SERVER CLASS
 * ============================================================
 *
 * INHERITANCE:
 *
 * Server extends Asset.
 *
 * INTERFACE:
 *
 * Server implements Asset.Reportable.
 */
class Server extends Asset
        implements Asset.Reportable {

    private String environment;


    /*
     * Constructor.
     */

    public Server(
            String assetId,
            String description,
            String assignedTo,
            String environment) {

        super(
                assetId,
                description,
                assignedTo
        );

        this.environment =
                environment;
    }


    /*
     * Override asset type.
     */

    @Override
    public String getAssetType() {

        return "Server";
    }


    /*
     * INTERFACE IMPLEMENTATION:
     *
     * Server implements generateReport().
     */
    @Override
    public String generateReport() {

        return "Server Report: "
                + getAssetId()
                + " | "
                + getDescription()
                + " | Assigned to: "
                + getAssignedTo()
                + " | Environment: "
                + environment;
    }


    /*
     * POLYMORPHISM:
     *
     * Server overrides displayInfo().
     */
    @Override
    public String displayInfo() {

        return String.format(
                "%-10s %-12s %-25s %-20s Environment: %s",
                getAssetId(),
                getAssetType(),
                getDescription(),
                getAssignedTo(),
                environment
        );
    }
}


/*
 * ============================================================
 * ASSET INVENTORY CLASS
 * ============================================================
 *
 * COMPOSITION:
 *
 * AssetInventory contains a collection of Asset objects.
 */
class AssetInventory {

    /*
     * COMPOSITION:
     *
     * AssetInventory owns a collection of Asset objects.
     */
    private final List<Asset> assets;


    /*
     * Constructor.
     */

    public AssetInventory() {

        assets =
                new ArrayList<>();
    }


    /*
     * Add an asset.
     */

    public void addAsset(Asset asset) {

        assets.add(asset);
    }


    /*
     * ========================================================
     * DISPLAY ALL ASSETS
     * ========================================================
     *
     * POLYMORPHISM:
     *
     * The collection contains Asset references.
     *
     * The actual objects are Laptop and Server.
     *
     * Java automatically calls the appropriate overridden
     * displayInfo() method.
     */

    public void displayAllAssets() {

        System.out.println();

        System.out.println(
                "=============================================================="
        );

        System.out.println(
                "                    IT ASSET INVENTORY"
        );

        System.out.println(
                "=============================================================="
        );


        System.out.printf(
                "%-10s %-12s %-25s %-20s%n",
                "ID",
                "TYPE",
                "DESCRIPTION",
                "ASSIGNED TO"
        );


        System.out.println(
                "--------------------------------------------------------------"
        );


        for (Asset asset : assets) {

            System.out.println(
                    asset.displayInfo()
            );
        }


        System.out.println(
                "=============================================================="
        );
    }


    /*
     * ========================================================
     * GENERATE REPORTS
     * ========================================================
     *
     * POLYMORPHISM:
     *
     * We convert each Asset reference to the Reportable
     * interface.
     *
     * Since Laptop and Server implement Reportable, this
     * works for both types.
     */

    public void generateAllReports() {

        System.out.println();

        System.out.println(
                "-------------------- ASSET REPORTS -------------------------"
        );

        System.out.println();


        for (Asset asset : assets) {

            /*
             * INTERFACE + POLYMORPHISM:
             *
             * The Asset reference is treated as a Reportable
             * reference.
             */
            Asset.Reportable report =
                    (Asset.Reportable) asset;


            System.out.println(
                    report.generateReport()
            );
        }


        System.out.println();
    }


    /*
     * ========================================================
     * POLYMORPHISM DEMONSTRATION
     * ========================================================
     */

    public void demonstratePolymorphism() {

        System.out.println();

        System.out.println(
                "------------------- POLYMORPHISM ---------------------------"
        );

        System.out.println();

        System.out.println(
                "Different child objects are stored using"
        );

        System.out.println(
                "the common Asset base-class reference."
        );

        System.out.println();


        for (Asset asset : assets) {

            System.out.println(
                    "Reference Type: Asset"
            );

            System.out.println(
                    "Actual Object Type: "
                    + asset.getClass().getSimpleName()
            );

            System.out.println(
                    "getAssetType(): "
                    + asset.getAssetType()
            );


            /*
             * POLYMORPHISM:
             *
             * Java determines at runtime whether the object
             * is a Laptop or Server and calls the correct
             * generateReport() implementation.
             */
            Asset.Reportable report =
                    (Asset.Reportable) asset;


            System.out.println(
                    "generateReport():"
            );

            System.out.println(
                    report.generateReport()
            );

            System.out.println(
                    "--------------------------------------------------------------"
            );
        }


        System.out.println();

        System.out.println(
                "POLYMORPHISM SUCCESSFULLY DEMONSTRATED."
        );
    }
}
